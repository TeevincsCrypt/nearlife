# ---------------------------------------------------------------------------
# NEARLIFE environment variables. Everything is optional: with no variables set
# the app runs in "guest + memory + off-chain ledger" mode for local demos.
# ---------------------------------------------------------------------------

# --- Privy (social login: email + Google, embedded NEAR wallet) ---
# Create an app at https://dashboard.privy.io, enable Email + Google login methods.
NEXT_PUBLIC_PRIVY_APP_ID=
# Optional: Privy verification key (PEM). If empty, the server uses Privy's JWKS endpoint.
PRIVY_VERIFICATION_KEY=
# Also show the "Play as guest" button when Privy is configured (handy for judges).
NEXT_PUBLIC_ENABLE_GUEST=true

# --- Shared game state (required on Vercel so all serverless instances share one world) ---
# Upstash Redis REST credentials (Vercel KV / Upstash integration sets KV_REST_API_* automatically).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Redis key for the world state (change to start a fresh world).
NEARLIFE_STATE_KEY=nearlife:state:v1

# --- NEAR ---
NEXT_PUBLIC_NEAR_NETWORK=testnet
# Defaults to https://rpc.testnet.near.org / https://rpc.mainnet.near.org
NEAR_RPC_URL=
# Secret used to derive implicit NEAR accounts for NPC agents and players without a Privy NEAR wallet.
NEARLIFE_ACCOUNT_SECRET=change-me
# Account id used as the market escrow in NEP-245 events.
NEARLIFE_ESCROW_ACCOUNT=market.nearlife.testnet

# Optional on-chain settlement: replay every NEP-245 ledger event against a NEP-245 contract.
# Leave empty to keep the NEP-245 ledger off-chain (default).
NEP245_CONTRACT_ID=
NEAR_OPERATOR_ACCOUNT_ID=
NEAR_OPERATOR_PRIVATE_KEY=

# --- Simulation ---
# How often NPC agents act (ms). The world ticks lazily whenever someone polls /api/state.
NPC_TICK_MS=10000
# Protects GET /api/npc-tick when called by Vercel Cron.
CRON_SECRET=
# Enables POST /api/reset with "Authorization: Bearer <token>".
NEARLIFE_ADMIN_TOKEN=
